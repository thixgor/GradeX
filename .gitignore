# Manual da Histologia: mapa de progresso do envio ao Vercel Blob.
# São ~9.156 entradas de bookkeeping do upload — nenhum código lê este arquivo
# (o resolver deriva a URL de sha256 + extensão + NEXT_PUBLIC_HISTOLOGIA_BLOB_BASE),
# então versioná-lo só adicionaria 2 MB de ruído a cada reenvio.
public/Manual-Histologia/dados/mapa-assets-blob.json

# Derivadas WebP do acervo da Histologia: ~0,9 GiB de arquivos gerados a partir
# do acervo Git LFS por scripts/histologia/recomprimir-acervo.mjs. São
# reproduzíveis a partir da origem e vão para o CDN, nunca para o repositório.
public/Manual-Histologia/derivadas-webp/

# Manifesto das derivadas WebP: artefato gerado por recomprimir-acervo.mjs.
# Não é versionado porque muda inteiro a cada reconversão. O pipeline recusa
# regenerar os dados sem ele quando o CDN está servindo WebP — ver a guarda em
# scripts/histologia/construir-dados.mjs.
public/Manual-Histologia/dados/manifesto-derivadas.json

# Cache do Python (scripts/pwa/gerar-icones-android.py)
__pycache__/
*.pyc

# Relatórios da sincronização de imagens (scripts/midia)
.midia/
