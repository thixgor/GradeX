
# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/gradex

# JWT Secret (use a strong random string in production)
JWT_SECRET=your-secret-key-change-this-in-production

# Segurança de sessão: nº máximo de dispositivos logados por conta ao mesmo
# tempo. Acima disso, um novo login derruba o aparelho mais antigo (anti
# compartilhamento de conta / pirataria de material). Padrão: 3.
MAX_DEVICES_PER_USER=3

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Google Sign-In (Google Identity Services)
# OBRIGATÓRIO para o botão "Entrar com Google" renderizar. Sem isto o botão
# fica em branco na tela de login. Crie em https://console.cloud.google.com
# (OAuth 2.0 Client ID, tipo "Web application") e adicione a origem do site
# em "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Provider de pagamento
PAYMENT_PROVIDER=mercado_pago

# Mercado Pago (Brasil)
# IMPORTANTE: PUBLIC_KEY e ACCESS_TOKEN devem ser do MESMO ambiente (ambos TEST- ou ambos APP_USR-).
# Misturar ambientes causa "Unauthorized use of live credentials".
#
# Sandbox (testes):
#   MERCADOPAGO_ENV=sandbox
#   MERCADOPAGO_PUBLIC_KEY=TEST-...   (Public Key da conta de teste)
#   MERCADOPAGO_ACCESS_TOKEN=TEST-... (Access Token da conta de teste)
#   MERCADOPAGO_SANDBOX_PAYER_EMAIL=email-do-usuario-comprador-de-teste@testuser.com
#     ↑ Crie dois usuários de teste em: Suas integrações → Contas de teste
#       Um é o "vendedor" (usa as credenciais dele no .env), o outro é o "comprador" (e-mail aqui).
#
# Produção:
#   MERCADOPAGO_ENV=production
#   MERCADOPAGO_PUBLIC_KEY=APP_USR-...
#   MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_PUBLIC_KEY=TEST-aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890123456-000000-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-000000000
MERCADOPAGO_SANDBOX_PAYER_EMAIL=test_user_buyer@testuser.com
MERCADOPAGO_WEBHOOK_SECRET=replace-with-secret-from-mp-application
# Opcional — se ausente, derivado de NEXT_PUBLIC_APP_URL
MERCADOPAGO_NOTIFICATION_URL=https://domineaqui.com.br/api/webhooks/mercadopago

# ─────────────────────────────────────────────────────────
# Split de pagamentos (dividir entre duas contas — ex.: 70% / 30%)
# ─────────────────────────────────────────────────────────
# Como funciona: cada venda é cobrada normalmente do comprador. Uma parte
# (application_fee) é creditada na conta do SÓCIO (dona da APLICAÇÃO no Mercado
# Pago) e o restante fica na conta que processa o pagamento (a do
# MERCADOPAGO_ACCESS_TOKEN acima). Leia o passo a passo em:
#   docs/mercado-pago-split.md
#
# Para 70% na conta principal (ACCESS_TOKEN) e 30% para o sócio:
#   MERCADOPAGO_SPLIT_ENABLED=true
#   MERCADOPAGO_SPLIT_PARTNER_PERCENT=30
#
# Deixe desligado até concluir a configuração de marketplace/OAuth no painel MP.
MERCADOPAGO_SPLIT_ENABLED=false
MERCADOPAGO_SPLIT_PARTNER_PERCENT=30
#
# Credenciais OAuth da APLICAÇÃO de marketplace do SÓCIO (Client ID/Secret).
# Necessárias para o botão "Conectar marketplace" no admin
# (Configurações → Pagamentos). Depois de conectar, o access token vinculado ao
# marketplace é salvo no banco automaticamente — não precisa reeditar o
# MERCADOPAGO_ACCESS_TOKEN. O sócio obtém esses valores em:
#   Mercado Pago → Suas integrações → (aplicação) → Credenciais de produção
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Opcional — se ausente, derivado de NEXT_PUBLIC_APP_URL. DEVE ser idêntica à
# "Redirect URI" cadastrada na aplicação de marketplace do sócio.
MERCADOPAGO_OAUTH_REDIRECT_URI=https://domineaqui.com.br/api/admin/mercado-pago/oauth/callback

# Cron (Vercel Cron envia x-vercel-cron automaticamente; este token é fallback)
CRON_SECRET=replace-with-strong-random-string

# Token para crons chamados por serviço externo (ex.: cron-job.org), que não
# passam pelo header x-vercel-cron. Usado por /api/cron/revisao-espacada e
# /api/cron/profile-reminder via header `x-cron-token`.
CRON_TOKEN=replace-with-another-strong-random-string

# SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@domineaqui.com.br
SMTP_PASS=sua-senha-aqui

# E-mail que recebe notificações administrativas (ex.: resultado de sorteio de rifa).
# Se omitido, usa SMTP_USER.
ADMIN_NOTIFICATION_EMAIL=admin@domineaqui.com.br

# SMTP — controle de rajada do transporter pooled (evita "auth limit").
# Valores conservadores por padrão; suba com cautela conforme a Hostinger aguentar.
SMTP_MAX_CONNECTIONS=2
SMTP_MAX_MESSAGES=50
SMTP_RATE_LIMIT=3
# Remetente das campanhas (opcional). Padrão: "DomineAqui" <no-reply@domineaqui.com.br>
# SMTP_FROM="DomineAqui" <no-reply@domineaqui.com.br>

# ─────────────────────────────────────────────────────────
# Comunicação multicanal (fila outbox + WhatsApp)
# ─────────────────────────────────────────────────────────

# Rate-limit de saída (token bucket) por canal. Ajuste conforme os limites reais.
# COMMS_EMAIL_BURST=10
# COMMS_EMAIL_PER_SEC=2
# COMMS_WA_BURST=5
# COMMS_WA_PER_SEC=1
# Quantas mensagens o cron processa por canal por execução.
# COMMS_BATCH_PER_CHANNEL=40

# WhatsApp (integração NÃO-OFICIAL via worker Baileys always-on).
# O worker roda FORA da Vercel (VPS/Railway/Render). Ver docs/WHATSAPP_UNOFICIAL_SETUP.md.
# URL pública do worker que o adapter serverless chama:
WHATSAPP_WORKER_URL=https://seu-worker.exemplo.com
# Segredo compartilhado entre o app e o worker (Bearer). Use string longa e aleatória.
WHATSAPP_WORKER_SECRET=replace-with-strong-random-string
# (No host do worker) porta HTTP, diretório da sessão e intervalo mínimo entre envios.
# WHATSAPP_WORKER_PORT=8088
# WHATSAPP_SESSION_DIR=./.wa-session
# WHATSAPP_MIN_INTERVAL_MS=4000

# ─────────────────────────────────────────────────────────
# Sistema de Upload e Entrega Segura de PDFs
# ─────────────────────────────────────────────────────────

# Vercel Blob — armazenamento dos PDFs originais.
# Obter em: https://vercel.com/docs/storage/vercel-blob
# Token com permissão de leitura e escrita (Read/Write).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxx

# Tamanho máximo de PDF que pode ser enviado pelo admin (em MB).
# Hard cap no servidor: 500 MB. Padrão: 100 MB.
MATERIAL_UPLOAD_MAX_MB=100

# Exibido no front-end para feedback visual (deve corresponder ao acima).
NEXT_PUBLIC_MATERIAL_UPLOAD_MAX_MB=100

# Modo de proteção do PDF entregue ao aluno.
# Opções:
#   WATERMARK_ONLY          – Marca d'água + metadados (padrão)
#   WATERMARK_AND_FLATTEN   – Acima + flattening de formulários
#   WATERMARK_AND_RESTRICT  – Acima + hints de restrição de viewer
# Nota: não existe proteção 100% inviolável — estas camadas dificultam redistribuição.
PDF_PROTECTION_MODE=WATERMARK_ONLY

# Local only: open app pages without login (mock admin). Never use in production.
# DEV_BYPASS_AUTH=true

# ==========================================================================
# Meta Pixel (Facebook/Instagram Ads) — rastreamento de conversão
# --------------------------------------------------------------------------
# ID do Pixel criado no Meta Events Manager (events_manager > Fontes de dados).
# É um número público (aparece no HTML). Enquanto estiver vazio, TODO o
# rastreamento fica desligado — nada é carregado e nenhum evento é enviado.
# Eventos disparados quando configurado: PageView, ViewContent,
# CompleteRegistration (cadastro grátis), InitiateCheckout e Purchase.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API (server-side): capta Pix/boleto — que confirmam no webhook
# depois que o usuário sai da página — e recupera eventos perdidos por
# iOS/bloqueadores. Deduplicado com o Pixel pelo id do pedido. Este token é
# SECRETO — nunca use o prefixo NEXT_PUBLIC_ nele. Gere em: Events Manager >
# Configurações > Conversions API > Gerar token de acesso.
# META_CONVERSIONS_API_TOKEN=

# Opcional: código de "Test Events" do Events Manager para validar o CAPI sem
# afetar os dados de produção. Deixe vazio em produção.
# META_TEST_EVENT_CODE=
