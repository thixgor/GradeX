{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "git rev-parse HEAD~1 >/dev/null 2>&1 && git diff --quiet HEAD~1 HEAD -- ':(exclude)*.md' ':(exclude)*.txt' ':(exclude)docs' ':(exclude)__tests__' ':(exclude).claude' ':(exclude).windsurf' ':(exclude).github' ':(exclude)last_commit.diff' || exit 1",
  "regions": [
    "gru1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "app/api/presence/route.ts": {
      "maxDuration": 10,
      "memory": 512
    },
    "app/api/materiais/[id]/pdf-viewer/access/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/materiais/[id]/pdf-viewer/page/route.ts": {
      "maxDuration": 120,
      "memory": 2048
    },
    "app/api/webhooks/mercadopago/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/subscriptions-sweeper/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/payments-sweeper/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/fulfillment-sweeper/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/questions/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/exams/[id]/generate-questions/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/emails/send/route.ts": {
      "maxDuration": 60
    },
    "app/api/materiais/upload/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/materiais/download/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/admin/materiais/send-pdf-email/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/flashcards/manual/[id]/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/cron/raffles-sweeper/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/revisao-espacada/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/profile-reminder/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/comms-dispatcher/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/emails/campaigns/[campaignId]/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/emails/schedules/[id]/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/email-scheduler/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/banco/importar/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/cronogramas/extrair/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/midia-sync/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/avaliacoes-lembretes/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/banco/exportar/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/banco/listas/[id]/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/forms/[id]/submit/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/forum/upload/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/forum/uploads/[id]/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/manual-clinico/pdf-watermark/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/materiais/[id]/complementary/[itemId]/content/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/og/material/[id]/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "app/api/upload/route.ts": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/cron/subscriptions-sweeper",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/manual-clinico-expirations",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/raffles-sweeper",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/revisao-espacada",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/midia-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/ticket-replies",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "instagram.domineaqui.com.br"
        }
      ],
      "destination": "https://instagram.com/domineaqui.br",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "discord.domineaqui.com.br"
        }
      ],
      "destination": "https://discord.gg/vdfHcvDdMw",
      "permanent": true
    }
  ]
}
