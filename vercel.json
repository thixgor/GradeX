{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "gru1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/materiais/[id]/pdf-viewer/access/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/materiais/[id]/pdf-viewer/page/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/webhooks/mercadopago/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/subscriptions-sweeper/route.ts": {
      "maxDuration": 300
    },
    "app/api/questions/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/exams/[id]/generate-questions/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/emails/send/route.ts": {
      "maxDuration": 60
    },
    "app/api/materiais/upload/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/materiais/download/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/flashcards/manual/[id]/pdf/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/cron/raffles-sweeper/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/subscriptions-sweeper",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/manual-clinico-expirations",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/raffles-sweeper",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "instagram.domineaqui.com.br"
        }
      ],
      "destination": "https://instagram.com/domineaqui.br",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "discord.domineaqui.com.br"
        }
      ],
      "destination": "https://discord.gg/vdfHcvDdMw",
      "permanent": true
    }
  ]
}
