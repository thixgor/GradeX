{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "gru1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/stripe/webhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/questions/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/exams/[id]/generate-questions/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/emails/send/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "instagram.domineaqui.com.br"
        }
      ],
      "destination": "https://instagram.com/domineaqui.br",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "discord.domineaqui.com.br"
        }
      ],
      "destination": "https://discord.gg/vdfHcvDdMw",
      "permanent": true
    }
  ]
}