{"doenca":{"id":"pielonefrite-cronica","slug":"pielonefrite-cronica","nome":"Pielonefrite crônica","sinonimos":["nefropatia tubulointersticial crônica infecciosa","nefropatia do refluxo"],"sinonimosEmIngles":["chronic pyelonephritis","reflux nephropathy"],"sistemaId":"urinario-genital-masculino","orgaos":["Rim","Pelve renal"],"natureza":"nao-neoplasica","catalogoIds":["histopathology-atlas-chronic-pyelonephritis-1b245174e8","unicamp-pielonefrite-cronica-7fd666b97e","unicamp-rim-16-b04b7730b4"],"midiasPrincipais":[],"midiasBloqueadas":[],"mecanismoIds":["inflamacao-cronica","reparo-fibrose"],"padroesMorfologicos":["cicatrizes corticomedulares irregulares","atrofia tubular","tireoidização tubular"],"conteudo":{"objetivos":["Ligar cicatrizes irregulares e deformidade calicial ao padrão tubulointersticial microscópico.","Reconhecer tireoidização como consequência de atrofia tubular, não como tecido tireoidiano.","Separar pielonefrite crônica de outras nefrites tubulointersticiais e de infarto renal."],"definicao":"Doença tubulointersticial cicatricial produzida por infecção renal recorrente ou persistente, geralmente associada a refluxo vesicoureteral ou obstrução, com deformação de cálices e perda progressiva de néfrons.","etiologias":[{"agente":"Refluxo vesicoureteral com refluxo intrarrenal","categoria":"fisica","explicacao":"O retorno de urina infectada aos ductos papilares expõe segmentos renais repetidamente a bactérias e inflamação."},{"agente":"Obstrução urinária com infecção ascendente","categoria":"infecciosa","explicacao":"Estase facilita crescimento bacteriano e eleva a pressão, ampliando dano tubular e cicatrização."}],"fatoresDeRisco":[{"fator":"Anomalias do trato urinário, litíase ou obstrução prostática","porQue":"Favorecem estase, refluxo e episódios infecciosos repetidos.","forca":"estabelecido"}],"histologiaNormalDeReferencia":[{"titulo":"Túbulos e sistema coletor normais","caminhoNormal":["orgaos-e-sistemas","sistema-urinario","tubules-and-collecting-system","tubules-and-collecting-system-1"],"oQueObservar":"Túbulos justapostos, epitélio íntegro e interstício quase virtual, sem fibrose ou infiltrado inflamatório.","aproximado":false}],"mecanismoPatologicoGeral":[{"mecanismoId":"inflamacao-cronica","aplicacao":"Episódios recorrentes recrutam linfócitos e plasmócitos ao interstício e mantêm lesão epitelial tubular."},{"mecanismoId":"reparo-fibrose","aplicacao":"A reparação repetida substitui túbulos por matriz, distorce cálices e provoca glomerulosclerose secundária por perda de néfrons."}],"fisiopatologiaEspecifica":[{"etapa":"gatilho","titulo":"Refluxo ou obstrução permite infecção ascendente recorrente","porQue":"Urina estagnada e fluxo retrógrado vencem mecanismos de lavagem e transportam bactérias à pelve renal."},{"etapa":"resposta-tecidual","titulo":"Inflamação tubulointersticial repetida","porQue":"Lesão tubular e resposta imune se concentram nos trajetos alcançados pelo refluxo intrarrenal.","achadoAssociado":"Infiltrado linfoplasmocitário intersticial e túbulos lesionados."},{"etapa":"morfologia","titulo":"Atrofia tubular e cicatrização irregular","porQue":"Néfrons danificados colapsam e são substituídos por fibrose; túbulos remanescentes dilatam e acumulam cilindros.","achadoAssociado":"Tireoidização tubular e cicatrizes sobre cálices rombos."},{"etapa":"disfuncao","titulo":"Perda da capacidade de concentrar urina","porQue":"Dano tubular e medular prejudica gradiente osmótico antes de reduzir intensamente a filtração glomerular."},{"etapa":"clinica","titulo":"Poliúria, infecções recorrentes e hipertensão","porQue":"O defeito tubular reduz a concentração urinária, enquanto cicatrização e ativação neuro-hormonal favorecem elevação pressórica."},{"etapa":"complicacao","titulo":"Doença renal crônica e hipertensão","porQue":"Perda de massa renal causa hiperfiltração dos néfrons restantes, glomerulosclerose e ativação pressórica."}],"macroscopia":[{"achado":"Cicatrizes corticomedulares grosseiras e irregulares sobre cálices deformados","processo":"Inflamação e fibrose seguindo trajetos de refluxo ou obstrução.","consequencia":"Diferencia o padrão de cicatrizes finas e uniformes de algumas doenças vasculares.","peso":"sugestivo"}],"histopatologia":{"panoramica":{"procure":"Mapeie a alternância entre parênquima preservado e faixas cicatriciais que alcançam córtex e medula.","achados":[{"achado":"Fibrose corticomedular em distribuição irregular","processo":"Reparo de episódios focais e repetidos de infecção ascendente.","consequencia":"A distribuição em cunhas sobre cálices alterados sustenta o diagnóstico.","peso":"sugestivo"}]},"pequeno":{"procure":"Compare densidade tubular, largura do interstício e estado dos glomérulos.","achados":[{"achado":"Atrofia tubular com fibrose intersticial e inflamação crônica","processo":"Perda permanente de néfrons e cicatrização.","consequencia":"Explica a redução funcional progressiva, mas é compartilhada por outras nefropatias crônicas.","peso":"necessário"}]},"medio":{"procure":"Procure túbulos dilatados contendo cilindros homogêneos eosinofílicos.","achados":[{"achado":"Tireoidização tubular","processo":"Túbulos atróficos ou dilatados retêm secreção proteinácea.","consequencia":"É uma pista clássica de pielonefrite crônica, embora não exclusiva.","peso":"sugestivo"}]},"grande":{"procure":"Caracterize o infiltrado intersticial e atividade superposta.","achados":[{"achado":"Linfócitos e plasmócitos; neutrófilos quando há exacerbação","processo":"Inflamação crônica com possível infecção bacteriana ativa.","consequencia":"Neutrófilos intratubulares sugerem atividade, mas cultura define o agente.","peso":"frequente"}]},"sintese":"O diagnóstico combina cicatrização irregular, deformidade pielocalicial e dano tubulointersticial com tireoidização; nenhum achado microscópico isolado identifica refluxo ou bactéria."},"coloracoesEspeciais":[{"nome":"Tricrômico","tipo":"coloracao","pergunta":"Qual é a extensão da fibrose intersticial e atrofia tubular?","padraoEsperado":"Realce da matriz colágena que substitui o interstício normal.","limitacoes":["Quantifica cronicidade, mas não determina a causa."],"mudaODiferencial":"Ajuda a estimar dano irreversível; etiologia depende de imagem, cultura e distribuição."}],"imunoHistoquimica":[],"biologiaMolecular":[],"correlacaoClinica":[{"achadoMorfologico":"Dano tubular e medular","consequenciaFuncional":"Defeito de concentração urinária.","manifestacao":"Poliúria, noctúria e densidade urinária baixa."},{"achadoMorfologico":"Perda cicatricial de néfrons","consequenciaFuncional":"Hiperfiltração e redução progressiva da função renal.","manifestacao":"Hipertensão, proteinúria e doença renal crônica."}],"diagnosticosDiferenciais":[{"nome":"Nefrite tubulointersticial crônica medicamentosa","motivoDaConfusao":"Compartilha atrofia tubular, fibrose e inflamação crônica.","achadosCompartilhados":["fibrose intersticial","atrofia tubular"],"discriminador":"Ausência de cicatrizes relacionadas a cálices deformados e história de exposição relevante."},{"nome":"Infarto renal cicatrizado","motivoDaConfusao":"Forma cicatriz cortical em cunha.","achadosCompartilhados":["perda focal de parênquima","fibrose"],"discriminador":"Base capsular e ápice vascular, sem deformidade calicial característica e sem tireoidização difusa."}],"complicacoes":[{"complicacao":"Doença renal crônica terminal","mecanismo":"Perda cumulativa de néfrons e glomerulosclerose adaptativa."},{"complicacao":"Pionefrose ou sepse em obstrução infectada","mecanismo":"Drenagem impedida mantém grande carga bacteriana sob pressão."}],"normalVersusPatologico":[{"aspecto":"Interstício","normal":"Quase virtual, sem colágeno expansivo.","patologico":"Alargado por fibrose e infiltrado linfoplasmocitário."},{"aspecto":"Túbulos","normal":"Numerosos, justapostos e com epitélio íntegro.","patologico":"Atróficos ou dilatados, com cilindros eosinofílicos."}],"resumoDeProva":["Cicatriz irregular + cálice rombo/deformado aponta para pielonefrite crônica.","Tireoidização é túbulo atrófico/dilatado cheio de cilindro proteináceo.","O diagnóstico etiológico exige correlação com refluxo, obstrução, cultura e imagem."],"armadilhas":["Chamar tireoidização de específica.","Confundir cicatriz cortical de infarto com cicatriz pielonefrítica."],"perguntasDeAutoavaliacao":[{"pergunta":"Qual conjunto melhor distingue pielonefrite crônica de uma cicatriz renal inespecífica?","alternativas":["Cicatrizes irregulares associadas a cálices deformados e tireoidização tubular.","Apenas glomerulosclerose global.","Depósitos mesangiais de IgA.","Crescentes epiteliais difusos."],"indiceCorreto":0,"devolutiva":"A relação topográfica entre cicatriz e cálice, somada ao dano tubulointersticial, reconstrói a via de refluxo/obstrução.","nivel":"essencial"}],"referencias":[{"citacao":"Kumar V, Abbas AK, Aster JC. Robbins & Cotran Pathologic Basis of Disease. 10ª ed. Elsevier; 2021.","organizacao":"Elsevier","edicao":"10ª","ano":2021},{"citacao":"Renal scarring following urinary tract infections: review of experimental and clinical evidence.","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC5283888/","ano":2017}]},"revisao":{"estado":"revisao-medica","versao":1,"atualizadoEm":"2026-08-10","pendencias":["Revisão por nefropatologista antes de publicação médica definitiva."],"historico":[{"data":"2026-08-10","autor":"Edição Domine Aqui","nota":"Capítulo aprofundado criado e consolidado a partir de três conjuntos visuais."}]}},"entradas":[{"id":"histopathology-atlas-chronic-pyelonephritis-1b245174e8","fonteId":"histopathology-atlas","nome":"Pielonefrite crônica","nomeCompleto":"Pielonefrite crônica","nomeOriginal":"Chronic Pyelonephritis","descricao":"Chronic Pyelonephritis","sistemaId":"patologia-geral","sistemaCatalogado":"Patologia geral","capituloId":"diagnosticos-e-lesoes","capituloNome":"Doenças e lesões","midias":1,"midiasElegiveis":1,"modalidades":["Histologia"],"coloracoes":["HE"],"temLaminaVirtual":false,"doencaSlug":"pielo