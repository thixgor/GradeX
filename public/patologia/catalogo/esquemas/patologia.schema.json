{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gradex.example/schemas/histopatologia-patologia.json",
  "title": "Entrada catalogada de patologia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "fonteId",
    "nomeCatalogado",
    "slugCatalogado",
    "sistemaCatalogado",
    "quantidadeMidias",
    "paginasFonte",
    "revisao",
    "fragmentosDeMidia"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "fonteId": { "enum": ["unicamp", "histopathology-atlas"] },
    "nomeCatalogado": { "type": "string", "minLength": 1 },
    "slugCatalogado": { "type": "string", "minLength": 1 },
    "sistemaCatalogado": { "type": "string", "minLength": 1 },
    "descricaoCatalogada": { "type": "string" },
    "quantidadeMidias": { "type": "integer", "minimum": 0 },
    "quantidadeImagens": { "type": "integer", "minimum": 0 },
    "quantidadeVisualizadores": { "type": "integer", "minimum": 0 },
    "paginasFonte": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "revisao": {
      "type": "object",
      "required": ["estado", "nota"],
      "properties": {
        "estado": { "enum": ["pendente", "em-revisao", "publicado", "rejeitado"] },
        "nota": { "type": "string" }
      }
    },
    "fragmentosDeMidia": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^midias/.+\\.json\\.gz$" }
    }
  }
}
